{
  "schema": 1,
  "nota": "Manifesto de compatibilidade. O app compara esta matriz com a plataforma e a versao do DG Editor antes de baixar/atualizar ferramentas portateis.",
  "appMinimo": "0.3.0",
  "plataformas": {
    "win32-x64": { "rotulo": "Windows 10/11 x64", "suportado": true },
    "win32-arm64": { "rotulo": "Windows 11 ARM64", "suportado": true },
    "win32-ia32": { "rotulo": "Windows 32 bits", "suportado": false, "motivo": "Electron 33 x64 roda em x64; instale a versao x64." },
    "linux-x64": { "rotulo": "Linux x64", "suportado": false, "motivo": "Pacote Windows: use as ferramentas do sistema ou o pacote Linux." },
    "darwin-x64": { "rotulo": "macOS", "suportado": false, "motivo": "Use Homebrew/ffmpeg do sistema." }
  },
  "python": {
    "serie": "3.12",
    "minVersaoApp": "0.3.0",
    "repo": "astral-sh/python-build-standalone",
    "assetRegex": {
      "x64": "cpython-3\\.12\\.\\d+\\+\\d+-x86_64-pc-windows-msvc-install_only\\.tar\\.gz$",
      "arm64": "cpython-3\\.12\\.\\d+\\+\\d+-aarch64-pc-windows-msvc-install_only\\.tar\\.gz$"
    },
    "pacotes": ["edge-tts", "faster-whisper", "kokoro-onnx", "piper-tts", "supertonic", "pycdlib"],
    "pacotesMinVersaoApp": "0.3.0"
  },
  "ffmpeg": {
    "minVersaoApp": "0.3.0",
    "repo": "BtbN/FFmpeg-Builds",
    "tag": "latest",
    "assetRegex": {
      "x64": "ffmpeg-master-latest-win64-gpl\\.zip$",
      "arm64": "ffmpeg-master-latest-winarm64-gpl\\.zip$"
    },
    "urlFallback": {
      "x64": "https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-master-latest-win64-gpl.zip",
      "arm64": "https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-master-latest-winarm64-gpl.zip"
    },
    "filtrosObrigatorios": ["vidstabdetect", "loudnorm", "rubberband"]
  },
  "pacotesPip": {
    "minVersaoApp": "0.3.0",
    "essenciais": ["edge-tts"],
    "completos": ["faster-whisper", "kokoro-onnx", "piper-tts", "supertonic"]
  }
}

      "../midia/qualidade.ts",
      "../apps/index.ts",
      "../dossie.ts",
      "../paths.ts",
      "../chatstore.ts",
      "../dglog.ts",
      "../ipc-seguro.ts",
      "../shared/types.ts",
    "../brain/indice.ts",
    "../brain/editar.ts",
